# Environment
NODE_ENV=development

# API Server
PORT=4000
API_URL=http://localhost:4000
SESSION_SECRET=super_secret_session_key_minimum_32_characters_long_for_security

# Database (PostgreSQL)
DATABASE_URL="postgresql://notaria_user:notaria_password@localhost:5432/notaria_db?schema=public"

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CORS & Security
CORS_ORIGIN=http://localhost:3000

# Optional: Transactional Email Service (Resend)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=contact@aurelex-notaires.fr
