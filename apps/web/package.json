{
  "name": "@notaria/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema=prisma/schema.prisma && pnpm --filter @notaria/contracts build && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.2",
    "@notaria/contracts": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.66.9",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-intl": "^3.26.4",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@notaria/typescript-config": "workspace:*",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
